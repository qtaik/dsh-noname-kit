{
  "name": "dsh-noname-kit",
  "version": "1.10.9",
  "description": "Noname (无名杀) extension workshop for DeepSeek Harness: AI writes skills/cards with official-reference search, validation-gated writes, task history, and a web workshop panel.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "node scripts/test-all.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./presets/noname-dev/*": "./presets/noname-dev/*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.5": "compatible",
        "0.2.1-rc.3": "compatible",
        "0.2.1-alpha.5": "unknown",
        "0.2.1-rc.1": "unknown",
        "0.2.1-rc.2": "compatible"
      },
      "dshOperations": {
        "0.2.1-rc.5": {
          "install": "passed",
          "start": "passed",
          "uninstall": "passed",
          "rollback": "unknown"
        },
        "0.2.1-rc.3": {
          "install": "passed",
          "start": "passed",
          "uninstall": "passed",
          "rollback": "unknown"
        },
        "0.2.1-rc.2": {
          "install": "passed",
          "start": "passed",
          "uninstall": "passed",
          "rollback": "unknown"
        }
      }
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "presets",
    "scripts",
    "docs/screenshots",
    "online-kernel",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "noname",
    "sanguosha"
  ],
  "author": "qtaik",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qtaik/dsh-noname-kit.git"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "0.2.1-rc.5 || 0.2.1-rc.3 || 0.2.1-rc.2 || 0.2.1-rc.1 || 0.2.0-rc.2 || 0.1.7-rc.1 || 0.1.5-rc.2 || 0.1.5-rc.1 || 0.1.5-alpha.2 || 0.1.5-alpha.1 || 0.1.3-alpha.2 || 0.1.2-rc.1 || 0.1.2-alpha.5 || 0.1.2-alpha.4 || 0.1.2-alpha.3 || 0.1.2-alpha.2"
  },
  "dependencies": {
    "acorn": "8.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5 || 0.2.1-rc.3 || 0.2.1-rc.2 || 0.2.1-rc.1 || 0.2.0-rc.2 || 0.1.7-rc.1 || 0.1.5-rc.2 || 0.1.5-rc.1 || 0.1.5-alpha.2 || 0.1.5-alpha.1 || 0.1.3-alpha.2 || 0.1.2-rc.1 || 0.1.2-alpha.5 || 0.1.2-alpha.4 || 0.1.2-alpha.3 || 0.1.2-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.3-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  }
}
